{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "rules": {
    "files": "error",
    "exports": "error",
    "types": "error",
    "dependencies": "error",
    "devDependencies": "error"
  },
  "entry": [
    "index.html",
    "src/main.tsx",
    "src/test/setup.ts",
    "src/**/*.{test,spec}.{ts,tsx}",
    "e2e/**/*.spec.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "lingui.config.ts"
  ],
  "project": ["src/**/*.{ts,tsx}", "src/**/*.css", "*.config.ts"],
  "vite": false,
  "vitest": false,
  "playwright": false,
  "ignoreDependencies": ["@lingui/native-tools", "@vitest/browser"],
  "ignoreBinaries": ["make"],
  "ignore": [
    "src/lib/vet/rest.ts"
  ]
}
