{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vet Clinic",
  "version": "0.1.0",
  "identifier": "com.vetclinic.desktop",
  "build": {
    "beforeDevCommand": "make -C ../.. sidecar && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "make -C ../.. sidecar && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Vet Clinic",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
