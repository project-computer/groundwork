{
  "name": "@groundwork/clinic",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "sidecar": "make -C ../.. sidecar",
    "tauri": "tauri",
    "lint": "oxlint",
    "lint:strict": "oxlint --deny-warnings",
    "i18n:extract": "lingui extract --clean",
    "i18n:compile": "lingui compile --strict",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:screenshot": "vitest run --project browser screenshot",
    "test:screenshot:update": "vitest run --project browser screenshot -u",
    "test:pages": "playwright test",
    "test:rust": "make -C ../.. sidecar && cargo test --manifest-path src-tauri/Cargo.toml",
    "test:component": "vitest run --project browser component",
    "test:browser": "vitest run --project browser"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@lingui/core": "^6.10.1",
    "@lingui/react": "^6.10.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.12.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@lingui/babel-plugin-lingui-macro": "^6.10.1",
    "@lingui/cli": "^6.10.1",
    "@lingui/conf": "^6.10.1",
    "@lingui/format-po": "^6.10.1",
    "@lingui/native-tools": "^0.2.0",
    "@lingui/vite-plugin": "^6.10.1",
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "jsdom": "^30.1.3",
    "knip": "^6.43.0",
    "oxlint": "^1.90.0",
    "playwright": "^1.64.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vitest-browser-react": "^2.3.0"
  }
}
